{
  "name": "littlelegs-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --experimental-strip-types --test tests/auth-client.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:firebase": "playwright test -c playwright.firebase.config.ts",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.d.ts",
    "check:api": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.d.ts && git diff --exit-code -- src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.9"
  }
}
