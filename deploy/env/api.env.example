APP_ENV=production
AWS_DEFAULT_REGION=ap-east-2
SSM_PARAMETER_PATH=/littlelegs/prod

DB_SSL_CA=/opt/littlelegs/certs/global-bundle.pem
DB_POOL_RECYCLE_S=1800

CORS_ALLOWED_ORIGINS=https://littlelegs.vercel.app
APP_CHECK_ENFORCE=true
FIREBASE_PROJECT_ID=

DELETION_INTENT_BACKEND=s3
DELETION_INTENT_BUCKET=
DELETION_INTENT_PREFIX=littlelegs/deletion-intents/
