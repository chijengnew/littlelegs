[Unit]
Description=Littlelegs API (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=littlelegs
Group=littlelegs
WorkingDirectory=/opt/littlelegs/backend
EnvironmentFile=/etc/littlelegs/api.env
Environment=FORWARDED_ALLOW_IPS=127.0.0.1
ExecStart=/opt/littlelegs/venv/bin/python -m scripts.with_ssm_env --path ${SSM_PARAMETER_PATH} -- \
    /opt/littlelegs/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
